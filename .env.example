# Postgres connection string (Neon, Supabase, Railway, or your own Postgres).
# Used by apps/api-server at runtime and by packages/db for migrations.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Separate database used only when running the API test suite
# (npm run test -w @workspace/api-server). Point this at a throwaway
# database — the test setup truncates all tables between test files.
TEST_DATABASE_URL=postgresql://user:password@host:5432/dbname_test

# apps/api-server
API_PORT=5000

# Used by the frontend dev server (apps/savora)
PORT=5173
BASE_PATH=/

# Base URL the frontend uses to reach the API. In dev this points at the
# local api-server; in production, point it at your deployed API origin.
VITE_API_URL=http://localhost:5000
